{
  "$schema": "https://json.schemastore.org/chrome-manifest",
  "name": "Refined Forgejo",
  "version": "0.0.0",
  "description": "Simplifies the Forgejo interface and adds useful features",
  "homepage_url": "https://codeberg.org/forgejo-contrib/refined-forgejo",
  "manifest_version": 3,
  "minimum_chrome_version": "123",
  "browser_specific_settings": {
    "gecko": {
      "id": "{d328bf9b-a278-49a7-9af7-ef9d989b2ee3}",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": [
    "storage",
    "scripting",
    "contextMenus",
    "activeTab",
    "alarms"
  ],
  "host_permissions": [
    "*://codeberg.org/*",
    "*://*.codeberg.org/*"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "action": {
    "default_icon": "assets/icon.png"
  },
  "icons": {
    "128": "assets/icon.png"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "assets/background.js",
    "type": "module",
    "scripts": [
      "assets/background.js"
    ]
  },
  "content_scripts": [
    {
      "run_at": "document_start",
      "matches": [
        "*://codeberg.org/*",
        "*://*.codeberg.org/*"
      ],
      "css": [
        "assets/refined-forgejo.css"
      ],
      "js": [
        "assets/content-script.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/*"],
      "matches": ["https://codeberg.org/*", "https://*.codeberg.org/*"]
    }
  ]
}
